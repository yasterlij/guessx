# =============================================================================
# Guess X — Production Environment Variables
# =============================================================================
# Copy to .env.production and fill in real values.
# NEVER commit .env.production — it is gitignored.
#
# !! SECURITY WARNING !!
# All variables marked [SECRET] must be strong, randomly generated values.
# Never use the placeholders below in production. Generate with:
#   openssl rand -hex 32
# Store secrets in your secret manager (AWS Secrets Manager, Kubernetes
# Secrets, Vault, etc.) — never in plaintext config files or images.
# =============================================================================


# -----------------------------------------------------------------------------
# Core / Shared
# -----------------------------------------------------------------------------

# Application environment. Must be "production" in prod.
NODE_ENV=production

# Comma-separated list of allowed CORS origins (your frontend URLs).
# Include all domains that serve the web/mobile frontend.
CORS_ORIGINS=https://takelow.com,https://www.takelow.com

# Public base URL of the web frontend (used in payment redirects, emails).
APP_BASE_URL=https://takelow.com


# -----------------------------------------------------------------------------
# Database (PostgreSQL / Citus)
# -----------------------------------------------------------------------------

# Full connection string. Use TLS in production (sslmode=require or verify-full).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?sslmode=require
DATABASE_URL=postgresql://admin:CHANGE_ME@db-host:5432/guessx_db?sslmode=require

# [SECRET] Database password. Use a strong random password.
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_RANDOM_PASSWORD


# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------

# Redis connection string. Use TLS (rediss://) and AUTH in production.
# Format: redis://:PASSWORD@HOST:PORT  or  rediss://:PASSWORD@HOST:PORT
REDIS_URL=redis://:CHANGE_ME@redis-host:6379

# --- Optional: Redis Sentinel (HA) ---
# Uncomment and configure if using Redis Sentinel for high availability.
# REDIS_SENTINEL_HOSTS=sentinel1:26379,sentinel2:26379,sentinel3:26379
# REDIS_SENTINEL_MASTER_NAME=mymaster
# REDIS_SENTINEL_ROLE=master

# --- Optional: Redis Cluster ---
# Uncomment and configure if using Redis Cluster.
# REDIS_CLUSTER_NODES=node1:6379,node2:6379,node3:6379


# -----------------------------------------------------------------------------
# JWT / Authentication  [SECRET]
# -----------------------------------------------------------------------------
# !! These secrets MUST be identical across all 3 services !!
# Tokens are issued by identity-service and verified by all services.
# Generate with: openssl rand -hex 32

# [SECRET] JWT signing secret (access tokens, 15-min expiry).
JWT_SECRET=CHANGE_ME_TO_64_CHAR_HEX_SECRET

# [SECRET] JWT refresh token signing secret (long-lived tokens).
JWT_REFRESH_SECRET=CHANGE_ME_TO_DIFFERENT_64_CHAR_HEX_SECRET

# [SECRET] Internal API key for service-to-service authentication.
# Must match across all services. Uses constant-time comparison.
INTERNAL_API_KEY=CHANGE_ME_TO_64_CHAR_HEX_SECRET


# -----------------------------------------------------------------------------
# Bid Encryption  [SECRET]
# -----------------------------------------------------------------------------
# AES-256 key used to encrypt/decrypt bid amounts at rest.
# Must match across auction-engine and query-service.
# Generate with: openssl rand -hex 32
BID_ENCRYPTION_KEY=CHANGE_ME_TO_64_CHAR_HEX_SECRET


# -----------------------------------------------------------------------------
# Fintech Webhook  [SECRET]
# -----------------------------------------------------------------------------
# [SECRET] Shared secret for verifying generic fintech webhook signatures.
# Uses constant-time comparison with length guard.
FINTECH_WEBHOOK_SECRET=CHANGE_ME_TO_STRONG_RANDOM_SECRET


# -----------------------------------------------------------------------------
# SikinaPay Payment Gateway
# -----------------------------------------------------------------------------

# [SECRET] SikinaPay API secret key (live key for production).
SIKINA_SECRET_KEY=your_live_sikina_secret_key

# [SECRET] SikinaPay webhook signing secret.
SIKINA_WEBHOOK_SECRET=your_live_sikina_webhook_secret

# SikinaPay API base URL. Use production URL (not sandbox).
SIKINA_BASE_URL=https://api.sikinapay.com

# URL to redirect users after successful payment.
SIKINA_SUCCESS_REDIRECT_URL=https://takelow.com/payment/success

# URL to redirect users after failed payment.
SIKINA_FAILED_REDIRECT_URL=https://takelow.com/payment/failed

# Public webhook URL that SikinaPay calls for payment events.
SIKINA_WEBHOOK_URL=https://api.takelow.com/api/v1/payments/webhook/sikina


# -----------------------------------------------------------------------------
# Awash Bank Payment Gateway
# -----------------------------------------------------------------------------

# Awash Bank merchant identifier.
AWASH_MERCHANT_ID=your_live_awash_merchant_id

# [SECRET] Awash Bank API secret key.
AWASH_SECRET_KEY=your_live_awash_secret_key

# [SECRET] Awash Bank webhook signing secret.
AWASH_WEBHOOK_SECRET=your_live_awash_webhook_secret

# Awash Bank API base URL. Use production URL (not sandbox).
AWASH_BASE_URL=https://api.awashbank.com


# -----------------------------------------------------------------------------
# Inter-Service Communication
# -----------------------------------------------------------------------------
# Internal URLs for service-to-service calls (Docker/K8s network names).

# Identity service internal URL (used by auction-engine).
IDENTITY_SERVICE_URL=http://identity-service:3000

# Auction engine internal URL (used by other services if needed).
AUCTION_ENGINE_URL=http://auction-engine:3000

# Query service internal URL (used by other services if needed).
QUERY_SERVICE_URL=http://query-service:3000

# Public base URL for auction-engine uploads (used in image URLs).
UPLOAD_BASE_URL=https://api.takelow.com


# -----------------------------------------------------------------------------
# Service Ports
# -----------------------------------------------------------------------------
# Each service listens on PORT internally; Docker/K8s maps to the external port.
# Default is 3000 (container internal). Override only if needed.
PORT=3000


# -----------------------------------------------------------------------------
# CI/CD & Deployment (GitHub Actions / ECS)
# -----------------------------------------------------------------------------
# These are set as GitHub secrets/variables, not in this file directly.
# Listed here for documentation:
#
#   AWS_ACCESS_KEY_ID          — IAM access key for ECS deploys        [SECRET]
#   AWS_SECRET_ACCESS_KEY      — IAM secret key for ECS deploys        [SECRET]
#   AWS_REGION                 — AWS region (e.g., us-east-1)
#   GHCR_PAT                   — GitHub Container Registry PAT         [SECRET]
#   SLACK_WEBHOOK_URL          — Slack incoming webhook for CI alerts  [SECRET]
#   PAGERDUTY_INTEGRATION_KEY  — PagerDuty Events API v2 key           [SECRET]
#   ECS_CLUSTER                — ECS cluster name
#   ECS_IDENTITY_SERVICE       — ECS service name (identity)
#   ECS_AUCTION_SERVICE        — ECS service name (auction)
#   ECS_QUERY_SERVICE          — ECS service name (query)
#   ECS_WEB_SERVICE            — ECS service name (web)
#   ECS_IDENTITY_CONTAINER     — ECS container name (identity)
#   ECS_AUCTION_CONTAINER      — ECS container name (auction)
#   ECS_QUERY_CONTAINER        — ECS container name (query)
#   ECS_WEB_CONTAINER          — ECS container name (web)
