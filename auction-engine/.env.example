# =============================================================================
# Auction Engine — Environment Variables (production-ready)
# =============================================================================
# For local dev: copy to .env and adjust.
# For production: set these in your hosting platform (Railway / Render / Fly.io).
# =============================================================================

DATABASE_URL=postgresql://admin:secret@localhost:5432/guessx_db
REDIS_URL=redis://localhost:6379

JWT_SECRET=<must-match-identity-service-JWT_SECRET>
INTERNAL_API_KEY=<must-match-identity-service-INTERNAL_API_KEY>

PORT=3000

# --- Awash Bank ---
AWASH_MERCHANT_ID=your_merchant_id_here
AWASH_SECRET_KEY=your_secret_key_here
AWASH_WEBHOOK_SECRET=your_webhook_secret_here
AWASH_BASE_URL=https://api.awashbank.com
APP_BASE_URL=https://your-app.com

# --- Bid encryption ---
BID_ENCRYPTION_KEY=<must-match-across-auction-engine-instances>

# In production, include your Vercel frontend URL:
# CORS_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com
