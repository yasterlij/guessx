# =============================================================================
# Identity Service — Environment Variables (production-ready)
# =============================================================================
# For local dev: copy to .env and adjust.
# For production: set these in your hosting platform (Railway / Render / Fly.io).
# =============================================================================

DATABASE_URL=postgresql://admin:secret@localhost:5433/guessx_db
REDIS_URL=redis://localhost:6379

JWT_SECRET=<generate-a-strong-64-char-hex-secret>
JWT_REFRESH_SECRET=<generate-a-different-strong-64-char-hex-secret>
INTERNAL_API_KEY=<generate-another-strong-64-char-hex-secret>

PORT=3000

# In production, include your Vercel frontend URL:
# CORS_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com
