{
  "family": "takelow-query-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "${ECS_EXECUTION_ROLE_ARN}",
  "taskRoleArn": "${ECS_TASK_ROLE_ARN}",
  "containerDefinitions": [
    {
      "name": "query-service",
      "image": "ghcr.io/yasterlij/takelow/query-service:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "PORT", "value": "3000" },
        { "name": "NODE_ENV", "value": "production" },
        { "name": "CORS_ORIGINS", "value": "https://takelow.com,https://www.takelow.com" }
      ],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "${SECRET_DATABASE_URL}" },
        { "name": "REDIS_URL", "valueFrom": "${SECRET_REDIS_URL}" },
        { "name": "JWT_SECRET", "valueFrom": "${SECRET_JWT_SECRET}" },
        { "name": "BID_ENCRYPTION_KEY", "valueFrom": "${SECRET_BID_ENCRYPTION_KEY}" }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget --no-verbose --tries=1 --spider http://localhost:3000/api/v1/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 40
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/takelow/query-service",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
