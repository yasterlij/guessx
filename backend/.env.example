# =============================================================================
# Guess X Unified Backend — Environment Variables
# =============================================================================
PORT=3000
NODE_ENV=development

DATABASE_URL=postgresql://admin:secret@localhost:5433/guessx_db
# READ_REPLICA_URL=postgresql://admin:secret@localhost:5433/guessx_db
REDIS_URL=redis://localhost:6379

JWT_SECRET=replace_with_a_secure_random_jwt_secret_key
JWT_REFRESH_SECRET=replace_with_a_secure_random_jwt_refresh_secret_key
INTERNAL_API_KEY=replace_with_a_secure_random_internal_api_key

# --- Awash Bank ---
AWASH_MERCHANT_ID=your_merchant_id_here
AWASH_SECRET_KEY=your_secret_key_here
AWASH_WEBHOOK_SECRET=your_webhook_secret_here
AWASH_BASE_URL=https://sandbox.awashbank.com
APP_BASE_URL=http://localhost:5173

# --- Bid encryption ---
BID_ENCRYPTION_KEY=replace_with_a_32_byte_hex_or_random_encryption_key
BID_FEE=1

# --- Notifications / Fintech ---
SMS_API_KEY=
FINTECH_WEBHOOK_SECRET=

# --- Uploads & CORS ---
UPLOAD_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost
