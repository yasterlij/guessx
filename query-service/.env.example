# =============================================================================
# Query Service — Environment Variables (production-ready)
# =============================================================================
# For local dev: copy to .env and adjust.
# For production: set these in your hosting platform (Railway / Render / Fly.io).
# =============================================================================

DATABASE_URL=postgresql://admin:secret@localhost:5432/guessx_db
JWT_SECRET=<must-match-identity-service-JWT_SECRET>

PORT=3000

# Must match auction-engine BID_ENCRYPTION_KEY for bid amount decryption
BID_ENCRYPTION_KEY=<must-match-auction-engine-BID_ENCRYPTION_KEY>

# In production, include your Vercel frontend URL:
# CORS_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com
